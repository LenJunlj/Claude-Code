Node_attributes {
  LRM_D{
    LIN_protocol = "2.0" ;
    configured_NAD = 0x01 ;
    product_id = 0x0, 0x0, 255 ;
    P2_min = 0 ms ;
    ST_min = 0 ms ;
    configurable_frames {
      DR_LIN_1 = 0x0 ;
      MMA_LIN_1 = 0x0 ;
      MMAV_LIN_1 = 0x0 ;
      MMAV2_LIN_1 = 0x0 ;
    }
  }
  LRM_ML{
    LIN_protocol = "2.0" ;
    configured_NAD = 0x02 ;
    product_id = 0x0, 0x0, 255 ;
    P2_min = 0 ms ;
    ST_min = 0 ms ;
    configurable_frames {
      RRL_LIN_1 = 0x0 ;
      MRL_LIN_1 = 0x0 ;
      MRLV1_LIN_1 = 0x0 ;
      MRLV2_LIN_1 = 0x0 ;
    }
  }
}

Schedule_tables {
 LSCM_Schedule {
    DR_LIN_1 delay 10 ms ;
    MMA_LIN_1 delay 10 ms ;
    MMAV_LIN_1 delay 10 ms ;
    MMAV2_LIN_1 delay 10 ms ;
    RRL_LIN_1 delay 10 ms ;
    MRL_LIN_1 delay 10 ms ;
    MRLV1_LIN_1 delay 10 ms ;
    MRLV2_LIN_1 delay 10 ms ;
  }
}

